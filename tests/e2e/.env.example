# Base URL of the application (staging or prod)
BASE_URL=http://localhost:8080

# Supabase credentials (for direct API tests)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Test 1 — Signup + Onboarding
# Use a disposable email that does NOT already exist in the database.
TEST_SIGNUP_EMAIL=e2e-signup@example.com
TEST_SIGNUP_PASSWORD=SecurePass123!

# Test 2 — Multi-tenant isolation
# User A must belong to org "Konekt" (or any org with projects).
TEST_USER_A_EMAIL=user-a@konekt.com
TEST_USER_A_PASSWORD=password-a

# User B must belong to a DIFFERENT org (also with projects).
TEST_USER_B_EMAIL=user-b@other-org.com
TEST_USER_B_PASSWORD=password-b

# Test 3 — Client portal
# A valid client-portal token (from client_portal_links table).
TEST_CLIENT_PORTAL_TOKEN=valid-token-here
